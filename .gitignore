# Python / Virtual Environment
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
.eslintcache

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem

# Data & Models (Avoid tracking large data dumps or raw model files in git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
ml/models/*.joblib
ml/models/*.pkl
!ml/models/.gitkeep
ml/artifacts/*.csv
!ml/artifacts/.gitkeep
ml/artifacts/models/*.joblib
!ml/artifacts/models/.gitkeep
ml/artifacts/metrics/*.json
!ml/artifacts/metrics/.gitkeep
ml/artifacts/calibration/*.json
!ml/artifacts/calibration/.gitkeep
ml/artifacts/metadata/*.json
!ml/artifacts/metadata/.gitkeep



# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
